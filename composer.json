{
    "name": "alt-design/alt-tabs",
    "description": "A Statamic fieldtype that groups the fields after it into tabs, including inside Replicator and Bard sets, Grid rows and Groups.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "fieldtype",
        "tabs",
        "replicator",
        "bard",
        "grid",
        "control-panel"
    ],
    "authors": [
        {
            "name": "Alt Design",
            "homepage": "https://alt-design.net"
        }
    ],
    "support": {
        "issues": "https://github.com/alt-design/Alt-Tabs-Addon/issues"
    },
    "autoload": {
        "psr-4": {
            "AltDesign\\AltTabsAddon\\": "src"
        }
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.40"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "AltDesign\\AltTabsAddon\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Alt Tabs",
            "description": "Group the fields after a Tab field into tabs, inside blueprint sections, Replicator and Bard sets, Grid rows and Groups."
        },
        "laravel": {
            "providers": [
                "AltDesign\\AltTabsAddon\\ServiceProvider"
            ]
        }
    }
}
